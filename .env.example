# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# Owner seed (server scripts only)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
OWNER_NAME=System Administration
OWNER_MOBILE=9825063208
# Optional — if omitted with OWNER_MOBILE set, seed auto-generates a 6-digit PIN and prints it once
OWNER_LOGIN_PIN=
# Developer mobile login PIN bootstrap (server only — NEVER NEXT_PUBLIC_* / never commit real PIN)
# Used by: OWNER_LOGIN_PIN or DEVELOPER_LOGIN_PIN for seed / scripts/bootstrap-developer-pin.js
# Forces must_change_pin after first successful bootstrap login.
DEVELOPER_LOGIN_PIN=

# Owner Override PIN bootstrap (server only — never NEXT_PUBLIC_*)
OWNER_OVERRIDE_PIN_HASH=

# Developer / Owner Override secret (server only — NEVER NEXT_PUBLIC_*)
# Generate with: openssl rand -hex 48
DEVELOPER_OVERRIDE_KEY=generate-a-long-random-secret-with-openssl-rand-hex-48

# Optional Developer Override mobile + bcrypt PIN hash (server only)
# Generate hash: node -e "require('bcryptjs').hash('YOUR_PIN',12).then(console.log)"
DEVELOPER_OVERRIDE_MOBILE=
DEVELOPER_OVERRIDE_PIN_HASH=

# Optional: override legacy tile Auth password pepper (server only; keep stable in production)
# AUTH_PIN_PEPPER=

# Hidden /__kwos_dev_console + Netlify functions api/dev-verify.js & api/admin-create-user.js
# Set these in the Netlify dashboard (names used by the functions):
DEV_OVERRIDE_KEY=generate-a-long-random-secret-with-openssl-rand-hex-48
# SUPABASE_SERVICE_ROLE_KEY is listed above — also required for admin-create-user

# Optional seed PINs for scripts/seed-login-tiles.js (server only — never commit real values)
# SEED_ADMIN_PIN=
# SEED_CEO_PIN=
# SEED_ACCOUNTANT_PIN=
# SEED_SALESMAN_01_PIN=
# SEED_SALESMAN_02_PIN=

# Backup / Drive (optional)
CRON_SECRET=
BACKUP_TOKEN_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
NEXT_PUBLIC_APP_URL=http://localhost:3000
